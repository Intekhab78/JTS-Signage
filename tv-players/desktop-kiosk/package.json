{
  "name": "jts-signage-desktop-kiosk",
  "version": "1.0.0",
  "description": "JTS Signage Universal HDMI Kiosk Player (Windows / Linux / Raspberry Pi)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.jts.signage.kiosk",
    "productName": "JTS Signage",
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
